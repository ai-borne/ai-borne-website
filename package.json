{
  "name": "ai-borne-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest --exclude tests/ProductionReadiness.test.ts",
    "test:browser": "playwright test",
    "quality": "npm run typecheck && npm test -- --run && npm run build && npm run test:production && npm run test:browser && npm audit --audit-level=high",
    "test:production": "vitest run tests/ProductionReadiness.test.ts",
    "generate-insight": "tsx scripts/generate-daily-insight.ts",
    "pre-commit": "npm run build && npm test -- --run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "marked": "^18.0.7"
  },
  "overrides": {
    "fast-uri": "^3.1.8",
    "nanoid": "^3.3.19"
  }
}
